<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry field="networkPolicy" title="Network policy">
        <f:select/>
    </f:entry>
    <f:entry field="allowedDomainsText" title="Allowed domains">
        <f:textarea/>
    </f:entry>
    <f:entry field="cpus" title="CPUs">
        <f:textbox/>
    </f:entry>
    <f:entry field="memory" title="Memory">
        <f:textbox/>
    </f:entry>
</j:jelly>
